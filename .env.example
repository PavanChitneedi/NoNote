# ── Copy to .env and fill in values ───────────────────────────
# Generate secrets: openssl rand -hex 64

# Database
POSTGRES_DB=nodemap
POSTGRES_USER=nodemap
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Bcrypt
BCRYPT_ROUNDS=12

# CORS - set to your domain/IP
CORS_ORIGIN=http://localhost

# Ports exposed on host
HTTP_PORT=80
HTTPS_PORT=443

# Initial admin account (created on first boot)
ADMIN_EMAIL=admin@nodemap.local
ADMIN_PASSWORD=change_me_admin_password

# Set to true to allow self-registration
REGISTRATION_OPEN=false
